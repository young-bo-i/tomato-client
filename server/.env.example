# Server
HOST=0.0.0.0
PORT=8099

# Database
DATABASE_URL=postgres://tomato:tomato123@localhost:5432/tomato_kol
DATABASE_MAX_CONNECTIONS=100

# Redis
REDIS_URL=redis://localhost:6379

# JWT (must be at least 32 chars in production)
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars
JWT_EXPIRATION_HOURS=8760

# Initial admin — only seeded on first startup (ON CONFLICT DO NOTHING).
# Change password via the admin panel after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Logging
RUST_LOG=tomato_server=debug,actix_web=info
