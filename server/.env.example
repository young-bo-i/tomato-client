# Server
HOST=0.0.0.0
PORT=8099

# Database
DATABASE_URL=postgres://tomato:tomato123@localhost:5432/tomato_kol
DATABASE_MAX_CONNECTIONS=100

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars
JWT_EXPIRATION_HOURS=8760

# Logging
RUST_LOG=tomato_server=debug,actix_web=info

# Email (for income notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=notify@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=notify@example.com
